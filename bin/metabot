#!/usr/bin/env bash
# metabot - MetaBot CLI (single binary)
# Three command categories:
#   1. Bridge process control: update | start | stop | restart | logs | status
#   2. Bridge daemon API (localhost:9100): bots | bot | talk | schedule |
#      peers | stats | metrics | voice | health
#   3. metabot-core delegation: t5t | agents | memory | skills

set -euo pipefail

# Resolve METABOT_HOME: env var > script's parent dir (follows symlinks) > $HOME/metabot
if [[ -z "${METABOT_HOME:-}" ]]; then
  _src="${BASH_SOURCE[0]}"
  if command -v readlink &>/dev/null; then
    _src="$(readlink -f "$_src" 2>/dev/null || echo "$_src")"
  fi
  _sd="$(cd "$(dirname "$_src")/.." 2>/dev/null && pwd)" || _sd=""
  if [[ -n "$_sd" && -d "$_sd/.git" && -f "$_sd/package.json" ]]; then
    METABOT_HOME="$_sd"
  else
    METABOT_HOME="$HOME/metabot"
  fi
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

info()    { echo -e "${BLUE}[INFO]${NC} $*"; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }
warn()    { echo -e "${YELLOW}[WARN]${NC} $*"; }
error()   { echo -e "${RED}[ERROR]${NC} $*"; }

_backup_skill_path() {
  local source="$1"
  local backup_root="$2"
  [[ -e "$source" || -L "$source" ]] || return 0
  mkdir -p "$backup_root"
  local backup
  backup="$(mktemp -d "$backup_root/$(basename "$source").XXXXXX")"
  rmdir "$backup"
  mv "$source" "$backup"
}

_install_skill_bundle() {
  local source="$1"
  local destination="$2"
  local backup_root="$3"
  if [[ -d "$destination" ]] && diff -qr "$source" "$destination" >/dev/null 2>&1; then
    return 0
  fi
  _backup_skill_path "$destination" "$backup_root"
  mkdir -p "$destination"
  cp -R "$source/." "$destination/"
}

# --- Bridge daemon API config (Category 2): env vars > .env file > defaults ---
# Read API_PORT / API_SECRET / METABOT_URL from $METABOT_HOME/.env without
# clobbering values already exported in the environment.
_load_bridge_api_config() {
  local envf="$METABOT_HOME/.env"
  if [[ -f "$envf" ]]; then
    _api_port=$(sed -n 's/^API_PORT=//p' "$envf" 2>/dev/null || true)
    _api_secret=$(sed -n 's/^API_SECRET=//p' "$envf" 2>/dev/null || true)
    _api_url=$(sed -n 's/^METABOT_URL=//p' "$envf" 2>/dev/null || true)
  fi
  METABOT_URL="${METABOT_URL:-${_api_url:-http://localhost:${_api_port:-9100}}}"
  _api_secret="${API_SECRET:-${_api_secret:-changeme}}"
  METABOT_AUTH="Authorization: Bearer $_api_secret"
}

_json() { python3 -m json.tool 2>/dev/null || cat; }

cmd_update() {
  local update_source="${METABOT_UPDATE_SOURCE:-auto}"
  local update_version="${METABOT_UPDATE_VERSION:-}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --git)
        update_source="git"
        shift
        ;;
      --package|--tarball)
        update_source="package"
        shift
        ;;
      --version)
        [[ $# -ge 2 ]] || { error "--version requires x.y.z"; exit 1; }
        update_version="$2"
        shift 2
        ;;
      --version=*)
        update_version="${1#--version=}"
        shift
        ;;
      *)
        error "Unknown update option: $1"
        echo "  Usage: metabot update [--package|--git] [--version x.y.z]"
        exit 1
        ;;
    esac
  done

  update_version="${update_version#v}"
  if [[ -n "$update_version" ]] && [[ ! "$update_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    error "Invalid release version: $update_version (expected x.y.z)"
    exit 1
  fi

  if [[ "$update_source" == "auto" ]]; then
    if [[ -f "$METABOT_HOME/.metabot-package/manifest.json" ]]; then
      update_source="package"
    elif [[ -d "$METABOT_HOME/.git" ]]; then
      update_source="git"
    else
      update_source="package"
    fi
  fi

  if [[ -n "$update_version" && "$update_source" == "git" ]]; then
    error "--version selects an immutable Release package and cannot be combined with --git"
    exit 1
  fi

  if [[ "$update_source" != "git" ]]; then
    # Package installs refresh from the stable GitHub Release installer asset.
    # METABOT_UPDATE_INSTALLER_URL allows mirrors without coupling OSS installs
    # to an internal metabot-core endpoint.
    if [[ -f "$METABOT_HOME/install.sh" || -d "$METABOT_HOME" ]]; then
      local release_base="https://github.com/xvirobotics/metabot/releases/latest/download"
      local expected_version=""
      if [[ -n "$update_version" ]]; then
        release_base="https://github.com/xvirobotics/metabot/releases/download/v${update_version}"
        expected_version="$update_version"
      fi
      local installer_url="${METABOT_UPDATE_INSTALLER_URL:-$release_base/install.sh}"
      local tarball_url="${METABOT_PACKAGE_TARBALL_URL:-$release_base/metabot-runtime.tgz}"
      local checksums_url="${METABOT_PACKAGE_CHECKSUMS_URL:-$release_base/SHA256SUMS}"
      if [[ -n "$expected_version" ]]; then
        info "Refreshing MetaBot from immutable GitHub Release v${expected_version}"
      else
        info "Refreshing MetaBot from the latest GitHub Release package"
      fi
      exec bash -c '
        set -o pipefail
        curl -fsSL "$1" |
          METABOT_HOME="$2" \
          METABOT_PACKAGE_TARBALL_URL="$3" \
          METABOT_PACKAGE_CHECKSUMS_URL="$4" \
          METABOT_EXPECTED_PACKAGE_VERSION="$5" \
          bash
      ' bash "$installer_url" "$METABOT_HOME" "$tarball_url" "$checksums_url" "$expected_version"
    fi
    error "MetaBot not found at $METABOT_HOME"
    echo "  Run the installer first:"
    echo "    curl -fsSL https://github.com/xvirobotics/metabot/releases/latest/download/install.sh | bash"
    exit 1
  fi

  if [[ ! -d "$METABOT_HOME/.git" ]]; then
    error "Git update requested, but $METABOT_HOME is not a git checkout."
    echo "  Use the release package refresh instead:"
    echo "    metabot update --package"
    exit 1
  fi

  # Always re-exec from the repo copy before doing anything.
  # This prevents the running script (e.g. ~/.local/bin/metabot) from being
  # overwritten mid-execution when we copy CLI tools later.
  if [[ -z "${METABOT_REEXEC:-}" ]] && [[ -f "$METABOT_HOME/bin/metabot" ]]; then
    export METABOT_REEXEC=1
    exec "$METABOT_HOME/bin/metabot" update --git
  fi

  info "Pulling latest code..."
  cd "$METABOT_HOME"
  local old_head
  old_head="$(git rev-parse HEAD)"
  git pull --ff-only || { error "git pull failed"; exit 1; }

  # Re-exec if git pull updated this script (the repo copy we're running from)
  if ! git diff --quiet "$old_head" HEAD -- bin/metabot 2>/dev/null; then
    info "metabot CLI updated, re-launching with new version..."
    exec "$METABOT_HOME/bin/metabot" update --git
  fi

  info "Installing dependencies..."
  npm install --production=false

  info "Building bridge and metabot CLI..."
  npm run build:bridge
  npm run build -w @xvirobotics/cli

  # A personal-edition git checkout owns a local Core/Web UI when that PM2
  # process was created by install.sh. Keep it on the same exact checkout;
  # remote-Core users (no local process) remain untouched.
  if [[ "$(node -p "require('./package.json').metabotEdition || ''")" == "personal" ]] \
    && pm2 describe metabot-core &>/dev/null 2>&1; then
    info "Building local metabot-core and Web UI..."
    npm run build -w @xvirobotics/metabot-core-server
    npm run build -w @xvirobotics/metabot-core-web-ui
    pm2 restart metabot-core --update-env
  fi

  # Update CLI tools in ~/.local/bin.
  # `metabot` is the sole dispatcher (bridge process control + delegate to
  # metabot-core feature CLI). `mb`/`mm`/`mh`/`mbcore` are legacy and stay removed.
  LOCAL_BIN="$HOME/.local/bin"
  if [[ -d "$LOCAL_BIN" ]]; then
    info "Updating CLI tools..."
    for cli in metabot; do
      local src="$METABOT_HOME/bin/$cli"
      local dst="$LOCAL_BIN/$cli"
      if [[ -f "$src" ]]; then
        # Skip when $dst already points at $src — copying a file onto its own
        # symlink target errors out with `cp: 'a' and 'b' are the same file`.
        if [[ "$src" -ef "$dst" ]]; then
          continue
        fi
        cp "$src" "$dst"
        chmod +x "$dst"
      fi
    done
    # Clean up legacy CLIs (Phase 4 consolidation + temp shims).
    for legacy_cli in mb mm mh mbcore fd; do
      if [[ -f "$LOCAL_BIN/$legacy_cli" || -L "$LOCAL_BIN/$legacy_cli" ]]; then
        rm -f "$LOCAL_BIN/$legacy_cli"
      fi
    done
    success "CLI tools updated"
  fi

  # Update MetaBot-owned Skills in user-global Claude, Codex, and Kimi roots.
  SKILLS_DIR="$HOME/.claude/skills"
  CODEX_SKILLS_DIR="$HOME/.codex/skills"
  AGENTS_SKILLS_DIR="$HOME/.agents/skills"
  mkdir -p "$SKILLS_DIR" "$CODEX_SKILLS_DIR" "$AGENTS_SKILLS_DIR"
  info "Updating skills..."
  local src=""
  local -a lark_skill_names=(
    lark-base
    lark-calendar
    lark-contact
    lark-doc
    lark-drive
    lark-event
    lark-im
    lark-mail
    lark-minutes
    lark-openapi-explorer
    lark-shared
    lark-sheets
    lark-skill-maker
    lark-task
    lark-vc
    lark-whiteboard
    lark-wiki
    lark-workflow-meeting-summary
    lark-workflow-standup-report
  )
  # Phase 4 consolidation: `metamemory` and `skill-hub` skill bundles are
  # subsumed by the unified `metabot` skill (which delegates memory/skills/
  # agents/t5t to the metabot-core feature CLI). metabot-team is the compact
  # Agent Teams coordination skill. metaskill / metaschedule remain opt-in;
  # sources still ship in src/skills/* for manual copy.
  for skill in metabot metabot-team; do
    case "$skill" in
      metabot)      src="$METABOT_HOME/packages/skills/metabot" ;;
      metabot-team) src="$METABOT_HOME/packages/skills/metabot-team" ;;
      *)            src="" ;;
    esac
    if [[ -n "$src" && -d "$src" ]]; then
      for dst_root in "$SKILLS_DIR" "$CODEX_SKILLS_DIR" "$AGENTS_SKILLS_DIR"; do
        _install_skill_bundle "$src" "$dst_root/$skill" "$HOME/.metabot/skill-backups"
      done
    fi
  done
  for dst_root in "$SKILLS_DIR" "$CODEX_SKILLS_DIR" "$AGENTS_SKILLS_DIR"; do
    if [[ -e "$dst_root/voice" || -L "$dst_root/voice" ]]; then
      _backup_skill_path "$dst_root/voice" "$HOME/.metabot/skill-backups"
      info "Retired voice Skill from $dst_root"
    fi
  done
  # Strip legacy skill bundles (Phase 4 consolidation).
  for legacy in metamemory skill-hub; do
    for dst_root in "$SKILLS_DIR" "$CODEX_SKILLS_DIR" "$AGENTS_SKILLS_DIR"; do
      if [[ -e "$dst_root/$legacy" || -L "$dst_root/$legacy" ]]; then
        _backup_skill_path "$dst_root/$legacy" "$HOME/.metabot/skill-backups"
        info "Removed legacy $legacy skill from $dst_root (use \`metabot ${legacy/skill-hub/skills}\` instead)"
      fi
    done
  done
  # Clean up legacy feishu-doc skill
  if [[ -d "$SKILLS_DIR/feishu-doc" ]]; then
    rm -rf "$SKILLS_DIR/feishu-doc"
    info "Removed legacy feishu-doc skill"
  fi
  if [[ -d "$CODEX_SKILLS_DIR/feishu-doc" ]]; then
    rm -rf "$CODEX_SKILLS_DIR/feishu-doc"
  fi
  # Clean up legacy metaskill — now opt-in. Override with KEEP_METASKILL=1.
  if [[ -d "$SKILLS_DIR/metaskill" ]] && [[ "${KEEP_METASKILL:-}" != "1" ]]; then
    rm -rf "$SKILLS_DIR/metaskill"
    info "Removed legacy metaskill (opt-in — set KEEP_METASKILL=1 to keep)"
  fi
  if [[ -d "$CODEX_SKILLS_DIR/metaskill" ]] && [[ "${KEEP_METASKILL:-}" != "1" ]]; then
    rm -rf "$CODEX_SKILLS_DIR/metaskill"
  fi

  # Update lark-cli and its AI Agent skills only if previously installed.
  # New installs still opt in via install.sh; updates keep existing setups fresh.
  local has_lark_skills=false
  local skill_root
  for skill_root in "$AGENTS_SKILLS_DIR" "$SKILLS_DIR" "$CODEX_SKILLS_DIR"; do
    if [[ -d "$skill_root/lark-doc" ]]; then
      has_lark_skills=true
      break
    fi
  done
  if command -v lark-cli &>/dev/null; then
    info "Updating lark-cli..."
    if npm install -g @larksuite/cli@latest 2>/dev/null || npm install -g --prefix "$HOME/.local" @larksuite/cli@latest 2>/dev/null; then
      success "lark-cli updated ($(lark-cli --version 2>/dev/null || echo 'version unknown'))"
    else
      warn "lark-cli update failed; MetaBot update will continue"
    fi
    has_lark_skills=true
  fi
  if [[ "$has_lark_skills" == "true" ]]; then
    info "Updating lark-cli AI Agent skills..."
    if npx skills add larksuite/cli --all -y -g 2>/dev/null; then
      success "lark-cli AI Agent skills updated"
    else
      warn "lark-cli skills update failed; keeping existing installed copies"
    fi
    # Mirror lark-cli skills into Claude/Codex skill roots. Recent lark-cli
    # installs use ~/.agents/skills, while older installs may use ~/.claude.
    local lark_skill
    for lark_skill in "${lark_skill_names[@]}"; do
      local lark_src=""
      for skill_root in "$AGENTS_SKILLS_DIR" "$SKILLS_DIR" "$CODEX_SKILLS_DIR"; do
        if [[ -d "$skill_root/$lark_skill" ]]; then
          lark_src="$skill_root/$lark_skill"
          break
        fi
      done
      if [[ -n "$lark_src" ]]; then
        for dst_root in "$SKILLS_DIR" "$CODEX_SKILLS_DIR" "$AGENTS_SKILLS_DIR"; do
          mkdir -p "$dst_root/$lark_skill"
          # Skip when src and dst already resolve to the same inode
          # (lark-cli installs ~/.agents/skills/* and symlinks them into
          # ~/.claude/skills + ~/.codex/skills — cp would error on same-file).
          [[ "$lark_src" -ef "$dst_root/$lark_skill" ]] && continue
          if [[ "$lark_src" != "$dst_root/$lark_skill" ]]; then
            cp -r "$lark_src/." "$dst_root/$lark_skill/"
          fi
        done
      fi
    done
  fi
  success "Skills updated"

  # Update workspace skills if bots.json exists
  if [[ -f "$METABOT_HOME/bots.json" ]] && command -v node &>/dev/null; then
    local work_dir
    work_dir=$(node -e "
      const c=JSON.parse(require('fs').readFileSync('$METABOT_HOME/bots.json','utf-8'));
      const b=[...(c.feishuBots||[]),...(c.telegramBots||[]),...(c.wechatBots||[])];
      if(b[0])console.log(b[0].defaultWorkingDirectory);
    " 2>/dev/null || true)
    if [[ -n "$work_dir" ]]; then
      local ws_skills_dir="$work_dir/.claude/skills"
      local ws_codex_skills_dir="$work_dir/.codex/skills"
      local ws_agents_skills_dir="$work_dir/.agents/skills"
      local -a ws_skill_roots=("$ws_skills_dir" "$ws_codex_skills_dir" "$ws_agents_skills_dir")
      mkdir -p "${ws_skill_roots[@]}"

      # MetaBot-owned Skills are global-only. Retire historical project
      # mirrors so stale copies cannot shadow a current global bundle.
      for skill in metabot metabot-team voice; do
        for dst_root in "${ws_skill_roots[@]}"; do
          if [[ -e "$dst_root/$skill" || -L "$dst_root/$skill" ]]; then
            _backup_skill_path "$dst_root/$skill" "$work_dir/.metabot/skill-backups"
            info "Retired project-level $skill mirror from $dst_root"
          fi
        done
      done
      # Strip legacy skill bundles from a previously-deployed workspace.
      for legacy in metamemory skill-hub; do
        for dst_root in "${ws_skill_roots[@]}"; do
          if [[ -e "$dst_root/$legacy" || -L "$dst_root/$legacy" ]]; then
            _backup_skill_path "$dst_root/$legacy" "$work_dir/.metabot/skill-backups"
          fi
        done
      done
      # Copy lark-cli skills if previously installed
      if [[ "$has_lark_skills" == "true" ]]; then
        local lark_skill
        for lark_skill in "${lark_skill_names[@]}"; do
          local lark_src=""
          for skill_root in "$AGENTS_SKILLS_DIR" "$SKILLS_DIR" "$CODEX_SKILLS_DIR"; do
            if [[ -d "$skill_root/$lark_skill" ]]; then
              lark_src="$skill_root/$lark_skill"
              break
            fi
          done
          if [[ -n "$lark_src" ]]; then
            for dst_root in "${ws_skill_roots[@]}"; do
              mkdir -p "$dst_root/$lark_skill"
              [[ "$lark_src" -ef "$dst_root/$lark_skill" ]] && continue
              cp -r "$lark_src/." "$dst_root/$lark_skill/"
            done
          fi
        done
      fi
      # Clean up legacy feishu-doc in workspace
      if [[ -d "$ws_skills_dir/feishu-doc" ]]; then
        rm -rf "$ws_skills_dir/feishu-doc"
      fi
      if [[ -d "$ws_codex_skills_dir/feishu-doc" ]]; then
        rm -rf "$ws_codex_skills_dir/feishu-doc"
      fi
      # Workspace instruction files are user-owned. Updates leave AGENTS.md
      # and CLAUDE.md untouched.
      rm -f "$work_dir/.metabot/workspace-harness.sha256"
      success "Workspace Skill mirrors reconciled"
    fi
  fi

  info "Restarting MetaBot..."
  local metabot_pid=""
  metabot_pid="$(pm2 pid metabot 2>/dev/null | head -n 1 || true)"
  if [[ "$metabot_pid" =~ ^[1-9][0-9]*$ ]]; then
    cmd_restart --source update --reason "MetaBot update" --allow-legacy-prepare
  else
    # There is no running Bridge to quiesce or recover. Preserve the previous
    # update behavior for stopped/fresh installations.
    warn "MetaBot is not running; starting it without restart recovery."
    pm2 start ecosystem.config.cjs
  fi
  pm2 save --force 2>/dev/null || true

  success "MetaBot updated and restarted!"

  _update_core_workspace || true
}

# Optimization: if a sibling metabot-core checkout exists, pull + build it so
# the delegated feature CLI (`metabot t5t/agents/memory/skills`) stays in sync
# with the central server. Best-effort — failures don't break the bridge update.
_update_core_workspace() {
  local core_dir="$METABOT_HOME/../metabot-workspace/metabot-core"
  if [[ ! -d "$core_dir/.git" || ! -f "$core_dir/package.json" ]]; then
    return 0
  fi
  echo ""
  info "Updating sibling metabot-core workspace at $core_dir ..."
  (
    cd "$core_dir"
    if ! git pull --ff-only; then
      warn "metabot-core: git pull --ff-only failed (uncommitted changes?). Skipping build."
      exit 1
    fi
    info "metabot-core: installing dependencies..."
    npm install --include=dev --silent || {
      warn "metabot-core: npm install failed."
      exit 1
    }
    info "metabot-core: building..."
    npm run build || {
      warn "metabot-core: build failed."
      exit 1
    }
  ) && success "metabot-core workspace updated" || warn "metabot-core workspace update incomplete (feature CLI may be stale)"
}

# Persist a breadcrumb only after the running Bridge has checkpointed and
# notified every affected chat. The new process consumes it after it queues all
# continuation turns and sends completion cards.
_write_restart_breadcrumb() {
  local request_id="$1"
  local requester_bot="$2"
  local requester_chat="$3"
  local source="$4"
  local reason="$5"
  local resume="$6"
  local dir="${SESSION_STORE_DIR:-$HOME/.metabot}"
  RESTART_STATE_DIR="$dir" \
  RESTART_REQUEST_ID="$request_id" \
  RESTART_REQUESTER_BOT="$requester_bot" \
  RESTART_REQUESTER_CHAT="$requester_chat" \
  RESTART_SOURCE="$source" \
  RESTART_REASON="$reason" \
  RESTART_RESUME="$resume" \
    node <<'NODE'
const fs = require('node:fs');
const path = require('node:path');
const dir = process.env.RESTART_STATE_DIR;
if (!dir) throw new Error('restart state directory is missing');
fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
const file = path.join(dir, 'last-restart.json');
const temp = `${file}.${process.pid}.tmp`;
const value = {
  version: 1,
  restartedAt: Math.floor(Date.now() / 1000),
  requestId: process.env.RESTART_REQUEST_ID,
  source: process.env.RESTART_SOURCE || 'cli',
  resume: process.env.RESTART_RESUME !== 'false',
};
if (process.env.RESTART_REQUESTER_BOT) value.botName = process.env.RESTART_REQUESTER_BOT;
if (process.env.RESTART_REQUESTER_CHAT) value.chatId = process.env.RESTART_REQUESTER_CHAT;
if (process.env.RESTART_REASON) value.reason = process.env.RESTART_REASON;
fs.writeFileSync(temp, `${JSON.stringify(value)}\n`, { mode: 0o600 });
fs.renameSync(temp, file);
NODE
}

_clear_restart_breadcrumb() {
  local request_id="$1"
  local dir="${SESSION_STORE_DIR:-$HOME/.metabot}"
  RESTART_STATE_DIR="$dir" RESTART_REQUEST_ID="$request_id" node <<'NODE'
const fs = require('node:fs');
const path = require('node:path');
const file = path.join(process.env.RESTART_STATE_DIR, 'last-restart.json');
try {
  const parsed = JSON.parse(fs.readFileSync(file, 'utf8'));
  if (!parsed.requestId || parsed.requestId === process.env.RESTART_REQUEST_ID) fs.unlinkSync(file);
} catch {}
NODE
}

_restart_payload() {
  RESTART_REQUEST_ID="$1" \
  RESTART_REQUESTER_BOT="$2" \
  RESTART_REQUESTER_CHAT="$3" \
  RESTART_SOURCE="$4" \
  RESTART_REASON="$5" \
  RESTART_RESUME="$6" \
  RESTART_FORCE="$7" \
    node <<'NODE'
const value = {
  requestId: process.env.RESTART_REQUEST_ID,
  source: process.env.RESTART_SOURCE || 'cli',
  resume: process.env.RESTART_RESUME !== 'false',
  force: process.env.RESTART_FORCE === 'true',
};
if (process.env.RESTART_REQUESTER_BOT) value.requesterBot = process.env.RESTART_REQUESTER_BOT;
if (process.env.RESTART_REQUESTER_CHAT) value.requesterChat = process.env.RESTART_REQUESTER_CHAT;
if (process.env.RESTART_REASON) value.reason = process.env.RESTART_REASON;
process.stdout.write(JSON.stringify(value));
NODE
}

_prepare_controlled_restart() {
  local payload="$1"
  _load_bridge_api_config
  local response_file
  response_file="$(mktemp)"
  local http_code
  if ! http_code="$(curl -sS --connect-timeout 3 --max-time 30 -o "$response_file" -w '%{http_code}' \
    -X POST -H "$METABOT_AUTH" -H 'Content-Type: application/json' \
    --data "$payload" "$METABOT_URL/api/runtime/restart/prepare")"; then
    rm -f "$response_file"
    return 2
  fi
  if [[ "$http_code" == 2* ]]; then
    cat "$response_file"
    rm -f "$response_file"
    return 0
  fi
  if [[ "$http_code" == "404" ]]; then
    rm -f "$response_file"
    return 44
  fi
  error "Bridge rejected controlled restart preparation (HTTP $http_code): $(cat "$response_file")"
  rm -f "$response_file"
  return 1
}

_cancel_controlled_restart() {
  local request_id="$1"
  _load_bridge_api_config
  local payload
  payload="$(RESTART_REQUEST_ID="$request_id" node -e 'process.stdout.write(JSON.stringify({requestId: process.env.RESTART_REQUEST_ID}))')"
  curl -fsS -X POST -H "$METABOT_AUTH" -H 'Content-Type: application/json' \
    --data "$payload" "$METABOT_URL/api/runtime/restart/cancel" >/dev/null 2>&1 || true
}

cmd_start()   { pm2 start "$METABOT_HOME/ecosystem.config.cjs"; pm2 save --force 2>/dev/null || true; }
cmd_stop()    { pm2 stop metabot; }
cmd_restart() {
  local request_id=""
  local requester_bot="${METABOT_BOT_NAME:-}"
  local requester_chat="${METABOT_CHAT_ID:-}"
  local source="cli"
  local reason="MetaBot Bridge restart"
  local resume=true
  local force=false
  local allow_legacy_prepare=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --request-id) request_id="${2:?--request-id requires a value}"; shift 2 ;;
      --bot) requester_bot="${2:?--bot requires a value}"; shift 2 ;;
      --chat) requester_chat="${2:?--chat requires a value}"; shift 2 ;;
      --source) source="${2:?--source requires a value}"; shift 2 ;;
      --reason) reason="${2:?--reason requires a value}"; shift 2 ;;
      --resume) resume=true; shift ;;
      --no-resume) resume=false; shift ;;
      --force) force=true; shift ;;
      --allow-legacy-prepare) allow_legacy_prepare=true; shift ;;
      --help|-h)
        echo "Usage: metabot restart [--request-id ID] [--bot NAME --chat ID] [--reason TEXT] [--resume|--no-resume] [--force]"
        return 0
        ;;
      *) error "Unknown restart option: $1"; return 2 ;;
    esac
  done

  request_id="${request_id:-restart-$(node -e 'console.log(require("node:crypto").randomUUID())')}"
  local payload
  payload="$(_restart_payload "$request_id" "$requester_bot" "$requester_chat" "$source" "$reason" "$resume" "$force")"
  local prepared=false
  local prepare_rc=0
  if _prepare_controlled_restart "$payload" >/dev/null; then
    prepared=true
  else
    prepare_rc=$?
    if [[ "$prepare_rc" -eq 44 && "$allow_legacy_prepare" == true ]]; then
      warn "Running Bridge predates coordinated restart preparation; proceeding once for upgrade compatibility."
    elif [[ "$force" == true ]]; then
      warn "Controlled restart preparation failed; --force accepts that active work may not resume."
    else
      error "Restart cancelled because the Bridge could not checkpoint and notify all affected chats."
      return 1
    fi
  fi

  _write_restart_breadcrumb "$request_id" "$requester_bot" "$requester_chat" "$source" "$reason" "$resume"
  if ! pm2 restart metabot; then
    [[ "$prepared" == true ]] && _cancel_controlled_restart "$request_id"
    _clear_restart_breadcrumb "$request_id"
    error "PM2 rejected controlled restart $request_id; Bridge quiesce was cancelled."
    return 1
  fi
  success "Controlled restart submitted (requestId: $request_id)."
}
cmd_logs()    { pm2 logs metabot "${@}"; }
cmd_status()  { pm2 describe metabot; }

cmd_doctor() {
  local json=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=true; shift ;;
      --help|-h)
        echo "Usage: metabot doctor [--json]"
        echo "  Agent-native local diagnostics for runtime, PM2, package, core, bots, voice, Codex, and TeamClaude."
        exit 0
        ;;
      *)
        error "Unknown doctor option: $1"
        echo "  Usage: metabot doctor [--json]"
        exit 1
        ;;
    esac
  done

  METABOT_HOME="$METABOT_HOME" python3 - "$json" <<'PY'
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

want_json = sys.argv[1] == "true"
home = Path(os.environ.get("METABOT_HOME") or str(Path.home() / "metabot")).expanduser()

def load_env(path: Path):
    env = {}
    if not path.exists():
        return env
    for raw in path.read_text(errors="ignore").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        v = v.strip().strip('"').strip("'")
        env[k.strip()] = v
    return env

file_env = load_env(home / ".env")

def env(name, default=None):
    return os.environ.get(name) or file_env.get(name) or default

def run(cmd, timeout=4):
    try:
        p = subprocess.run(cmd, text=True, capture_output=True, timeout=timeout)
        return {"ok": p.returncode == 0, "code": p.returncode, "stdout": p.stdout.strip(), "stderr": p.stderr.strip()}
    except Exception as e:
        return {"ok": False, "code": None, "stdout": "", "stderr": str(e)}

def http_json(url, token=None, timeout=4):
    req = urllib.request.Request(url)
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read(512 * 1024).decode("utf-8", errors="replace")
            try:
                parsed = json.loads(body)
            except Exception:
                parsed = None
            return {"ok": 200 <= resp.status < 300, "status": resp.status, "json": parsed, "bodyPreview": body[:300]}
    except urllib.error.HTTPError as e:
        return {"ok": False, "status": e.code, "json": None, "bodyPreview": e.read(300).decode("utf-8", errors="replace")}
    except Exception as e:
        return {"ok": False, "status": None, "json": None, "bodyPreview": str(e)}

def channel_summary(status_json):
    if not isinstance(status_json, dict):
        return None
    channels = status_json.get("channels")
    if not isinstance(channels, dict):
        return None
    items = channels.get("items") if isinstance(channels.get("items"), list) else []
    return {
        "total": int(channels.get("total") or 0),
        "connected": int(channels.get("connected") or 0),
        "reconnecting": int(channels.get("reconnecting") or 0),
        "idle": int(channels.get("idle") or 0),
        "failed": int(channels.get("failed") or 0),
        "items": items,
    }

def check(name, ok, code=None, diagnosis="", recommendedAction="", canAutoFix=False, data=None):
    severity = "ok" if ok else "warn"
    item = {
        "name": name,
        "ok": bool(ok),
        "severity": severity,
        "code": code or ("ok" if ok else "check_failed"),
        "diagnosis": diagnosis,
        "recommendedAction": recommendedAction,
        "canAutoFix": bool(canAutoFix),
    }
    if data is not None:
        item["data"] = data
    checks.append(item)

checks = []
report = {
    "ok": True,
    "schemaVersion": 1,
    "generatedAt": int(time.time()),
    "metabotHome": str(home),
    "checks": checks,
}

check("metabot_home", home.exists(), "metabot_home_missing" if not home.exists() else "ok",
      f"METABOT_HOME resolves to {home}", "Run the installer or set METABOT_HOME to the installed runtime.", False,
      {"path": str(home), "hasPackageJson": (home / "package.json").exists(), "hasEnv": (home / ".env").exists(), "hasBotsJson": (home / "bots.json").exists()})

manifest_paths = [home / ".metabot-package" / "manifest.json", home / ".metabot-package" / "default.env"]
manifest_data = {}
if manifest_paths[0].exists():
    try:
        manifest_data = json.loads(manifest_paths[0].read_text())
    except Exception as e:
        manifest_data = {"parseError": str(e)}
check("package_manifest", any(p.exists() for p in manifest_paths),
      "package_manifest_missing" if not any(p.exists() for p in manifest_paths) else "ok",
      "Package manifest/default env marker found." if any(p.exists() for p in manifest_paths) else "No .metabot-package manifest/default.env marker found in runtime.",
      "Package builds should include .metabot-package/manifest.json; package default env may include .metabot-package/default.env.",
      False,
      {"manifest": manifest_data, "hasDefaultEnv": manifest_paths[1].exists()})

pm2 = shutil.which("pm2")
pm2_data = {"installed": bool(pm2)}
pm2_ok = False
if pm2:
    j = run([pm2, "jlist"])
    pm2_data["jlistOk"] = j["ok"]
    if j["ok"]:
        try:
            apps = json.loads(j["stdout"] or "[]")
            app = next((a for a in apps if a.get("name") == "metabot"), None)
            if app:
                e = app.get("pm2_env", {})
                pm2_data.update({
                    "status": e.get("status"),
                    "cwd": e.get("pm_cwd"),
                    "script": e.get("pm_exec_path"),
                    "restartTime": e.get("restart_time"),
                    "unstableRestarts": e.get("unstable_restarts"),
                })
                pm2_ok = e.get("status") == "online" and str(e.get("pm_cwd")) == str(home)
        except Exception as e:
            pm2_data["parseError"] = str(e)
check("pm2_runtime", pm2_ok, "pm2_wrong_cwd_or_offline" if not pm2_ok else "ok",
      "PM2 metabot is online and running from METABOT_HOME." if pm2_ok else "PM2 metabot is missing, offline, or running from a different cwd.",
      "Run from the desired runtime: pm2 delete metabot; cd $METABOT_HOME; pm2 start ecosystem.config.cjs --update-env.",
      True,
      pm2_data)

api_port = env("API_PORT", "9100")
api_secret = env("API_SECRET", "changeme")
metabot_url = env("METABOT_URL", f"http://localhost:{api_port}")
bridge_health = http_json(f"{metabot_url.rstrip('/')}/api/health", api_secret)
check("bridge_health", bridge_health["ok"], "bridge_health_failed" if not bridge_health["ok"] else "ok",
      "Local bridge health endpoint is reachable." if bridge_health["ok"] else "Local bridge health endpoint is not reachable.",
      "Check PM2 status, API_PORT/API_SECRET, and logs/error.log.",
      False,
      {"url": metabot_url, "status": bridge_health["status"], "response": bridge_health["json"] or bridge_health["bodyPreview"]})

bridge_status = http_json(f"{metabot_url.rstrip('/')}/api/status", api_secret)
channels = channel_summary(bridge_status["json"])
channels_ok = bool(channels is not None) and channels["failed"] == 0 and channels["reconnecting"] == 0 and channels["connected"] == channels["total"]
check("channel_connections", channels_ok,
      "ok" if channels_ok else ("channel_connections_unhealthy" if channels is not None else "channel_status_unavailable"),
      "Lark/Feishu channel connections are healthy." if channels_ok else "One or more Lark/Feishu channels are disconnected, reconnecting, or unavailable.",
      "Check the local network/proxy and configured Lark/Feishu WebSocket state in /api/status; MetaBot should reconnect automatically.",
      False,
      channels or {"status": bridge_status["status"]})

core_url = env("METABOT_CORE_URL", "http://localhost:9200").rstrip("/")
core_token_present = bool(env("METABOT_CORE_TOKEN") or (Path.home() / ".metabot-core" / "token").exists())
core_health = http_json(f"{core_url}/health")
check("metabot_core", core_health["ok"], "core_unreachable" if not core_health["ok"] else "ok",
      "metabot-core health endpoint is reachable." if core_health["ok"] else "metabot-core health endpoint is not reachable.",
      "Check VPN/network and METABOT_CORE_URL.",
      False,
      {"url": core_url, "status": core_health["status"], "tokenPresent": core_token_present, "response": core_health["json"] or core_health["bodyPreview"]})

bots_data = []
bots_path = home / "bots.json"
if bots_path.exists():
    try:
        cfg = json.loads(bots_path.read_text())
        all_bots = []
        for key in ("feishuBots", "telegramBots", "webBots", "wechatBots"):
            for b in cfg.get(key, []) or []:
                all_bots.append((key, b))
        for platform, b in all_bots:
            voice = b.get("voiceReply") or {}
            wd = b.get("defaultWorkingDirectory")
            bots_data.append({
                "name": b.get("name"),
                "platform": platform,
                "engine": b.get("engine", "codex"),
                "workingDirectory": wd,
                "workingDirectoryExists": bool(wd and Path(wd).expanduser().exists()),
                "voiceReplyEnabled": voice.get("enabled"),
            })
    except Exception as e:
        bots_data.append({"parseError": str(e)})
bots_ok = bool(bots_data) and not any("parseError" in b for b in bots_data)
check("bots_config", bots_ok, "bots_config_missing_or_invalid" if not bots_ok else "ok",
      "bots.json parsed." if bots_ok else "bots.json missing, empty, or invalid.",
      "Create/fix bots.json or run install.sh.",
      False,
      {"bots": bots_data})

voice_default = {
    "defaultOn": env("METABOT_VOICE_REPLY_DEFAULT_ON"),
    "provider": env("METABOT_VOICE_REPLY_PROVIDER") or env("FEISHU_VOICE_REPLY_PROVIDER"),
    "hasVolcengineAppId": bool(env("VOLCENGINE_TTS_APPID")),
    "hasVolcengineAccessKey": bool(env("VOLCENGINE_TTS_ACCESS_KEY")),
    "hasOpenAIKey": bool(env("OPENAI_API_KEY")),
}
voice_ok = bool(voice_default["provider"] or voice_default["hasVolcengineAppId"] or voice_default["hasOpenAIKey"])
check("voice_defaults", voice_ok, "voice_defaults_missing" if not voice_ok else "ok",
      "Voice/TTS defaults appear configured." if voice_ok else "No voice/TTS defaults found.",
      "Install package default env or configure VOLCENGINE_TTS_* / OPENAI_API_KEY and bot voiceReply.",
      False,
      voice_default)

codex_path = env("CODEX_EXECUTABLE_PATH") or shutil.which("codex")
codex_home = Path(env("CODEX_HOME", str(Path.home() / ".codex"))).expanduser()
codex_config = codex_home / "config.toml"

def parse_codex_feature_list(output):
    features = {}
    for raw in output.splitlines():
        line = raw.strip()
        if not line or line.startswith("Usage:") or line.startswith("Commands:"):
            continue
        parts = line.split()
        if len(parts) < 3 or parts[-1] not in ("true", "false"):
            continue
        name = parts[0]
        stage = " ".join(parts[1:-1])
        features[name] = {"stage": stage, "enabled": parts[-1] == "true"}
    return features

def count_codex_mcp_servers(config_path):
    if not config_path.exists():
        return 0
    count = 0
    for raw in config_path.read_text(errors="ignore").splitlines():
        if raw.strip().startswith("[mcp_servers."):
            count += 1
    return count

codex_data = {
    "executable": codex_path,
    "hasOpenAIKey": bool(env("OPENAI_API_KEY")),
    "hasCodexApiKey": bool(env("CODEX_API_KEY")),
    "baseUrl": env("CODEX_BASE_URL") or env("OPENAI_BASE_URL"),
    "model": env("CODEX_MODEL"),
    "codexHome": str(codex_home),
    "configTomlExists": codex_config.exists(),
    "skillsDirExists": (codex_home / "skills").is_dir(),
    "agentsDirExists": (codex_home / "agents").is_dir(),
    "memoriesDirExists": (codex_home / "memories").is_dir(),
    "memoryDbExists": bool(list(codex_home.glob("memories_*.sqlite"))),
    "mcpServerCount": count_codex_mcp_servers(codex_config),
}
codex_ok = bool(codex_path)
if codex_path:
    v = run([codex_path, "--version"], timeout=3)
    codex_data["versionOk"] = v["ok"]
    codex_data["version"] = v["stdout"] or v["stderr"]
    features_result = run([codex_path, "features", "list"], timeout=5)
    codex_data["featuresListOk"] = features_result["ok"]
    if features_result["ok"]:
        features = parse_codex_feature_list(features_result["stdout"])
        important_features = [
            "multi_agent",
            "memories",
            "plugins",
            "hooks",
            "browser_use",
            "computer_use",
            "image_generation",
            "guardian_approval",
            "prevent_idle_sleep",
        ]
        codex_data["features"] = {name: features.get(name) for name in important_features if name in features}
check("codex_cli", codex_ok, "codex_missing" if not codex_ok else "ok",
      "Codex executable found." if codex_ok else "Codex executable not found.",
      "Install Codex CLI or set CODEX_EXECUTABLE_PATH.",
      False,
      codex_data)

codex_features = codex_data.get("features", {})
required_codex_features = ["multi_agent", "memories"]
missing_codex_features = [
    name for name in required_codex_features
    if not codex_features.get(name, {}).get("enabled")
]
codex_agent_features_ok = bool(codex_path) and not missing_codex_features and codex_data["skillsDirExists"] and (codex_data["memoriesDirExists"] or codex_data["memoryDbExists"])
check("codex_agent_features", codex_agent_features_ok,
      "codex_agent_features_missing" if not codex_agent_features_ok else "ok",
      "Codex multi-agent, memories, skills, and memory storage are ready." if codex_agent_features_ok else "Codex agent features are missing or disabled.",
      "Run install.sh with Codex selected, or add [features] multi_agent=true and memories=true to ~/.codex/config.toml; ensure ~/.codex/skills and ~/.codex/memories exist.",
      False,
      {
          "requiredFeatures": required_codex_features,
          "missingFeatures": missing_codex_features,
          "skillsDirExists": codex_data["skillsDirExists"],
          "agentsDirExists": codex_data["agentsDirExists"],
          "memoriesDirExists": codex_data["memoriesDirExists"],
          "memoryDbExists": codex_data["memoryDbExists"],
          "mcpServerCount": codex_data["mcpServerCount"],
      })

team_base = None
for candidate in (env("CODEX_BASE_URL"), env("OPENAI_BASE_URL"), env("ANTHROPIC_BASE_URL")):
    if candidate and "teamclaude" in candidate:
        team_base = candidate.split("/openai/")[0].rstrip("/")
        break
team_token = env("OPENAI_API_KEY") or env("CODEX_API_KEY") or env("ANTHROPIC_AUTH_TOKEN") or env("ANTHROPIC_API_KEY")
team_data = {"baseUrl": team_base, "tokenPresent": bool(team_token)}
team_ok = bool(team_base and team_token)
if team_ok:
    me = http_json(f"{team_base}/api/me", team_token)
    team_data.update({"meStatus": me["status"], "me": me["json"] or me["bodyPreview"]})
    if me["status"] in (401, 403):
        team_ok = False
check("teamclaude", team_ok, "teamclaude_not_configured_or_invalid" if not team_ok else "ok",
      "TeamClaude endpoint/token appear configured." if team_ok else "TeamClaude endpoint/token not configured or token check failed.",
      "Set TeamClaude base URL and token, then verify token owner before assigning to bots.",
      False,
      team_data)

report["ok"] = all(c.get("ok") for c in checks if c["name"] in (
    "metabot_home", "pm2_runtime", "bridge_health", "channel_connections"
))
report["summary"] = {
    "ok": sum(1 for c in checks if c["ok"]),
    "warn": sum(1 for c in checks if not c["ok"]),
    "criticalOk": report["ok"],
}

if want_json:
    print(json.dumps(report, ensure_ascii=False, indent=2))
else:
    print(f"MetaBot doctor: {'OK' if report['ok'] else 'WARN'}")
    print(f"  METABOT_HOME: {home}")
    for c in checks:
        mark = "✓" if c["ok"] else "!"
        print(f"  {mark} {c['name']}: {c['code']}")
        if not c["ok"] and c["recommendedAction"]:
            print(f"    next: {c['recommendedAction']}")
    print("\nUse `metabot doctor --json` for agent-readable diagnostics.")
PY
}

# Resolve the metabot-core feature CLI (t5t/agents/memory/skills).
# Order: explicit override > in-tree monorepo > sibling workspace > npm-global on PATH.
_resolve_core_cli() {
  if [[ -n "${METABOT_CORE_CLI:-}" && -x "$METABOT_CORE_CLI" ]]; then
    echo "$METABOT_CORE_CLI"; return 0
  fi
  # In-tree (monorepo): packages/cli is shipped alongside this script.
  local intree="$METABOT_HOME/packages/cli/bin/metabot"
  if [[ -f "$intree" ]]; then
    echo "$intree"; return 0
  fi
  # Sibling workspace (legacy two-repo layout — kept during migration).
  local ws="$METABOT_HOME/../metabot-workspace/metabot-core/packages/cli/bin/metabot"
  if [[ -f "$ws" ]]; then
    echo "$ws"; return 0
  fi
  # npm-linked global: a `metabot-core` bin on PATH (NOT this script).
  local g
  g="$(command -v metabot-core 2>/dev/null || true)"
  if [[ -n "$g" ]]; then echo "$g"; return 0; fi
  return 1
}

cmd_delegate() {
  local core_cli
  if ! core_cli="$(_resolve_core_cli)"; then
    error "'metabot $1' needs the metabot-core CLI, which isn't installed here."
    echo "  Fix one of:" >&2
    echo "    - Build the in-tree CLI: cd \"$METABOT_HOME\" && npm ci && npx tsc -b" >&2
    echo "    - Or point at it:        export METABOT_CORE_CLI=/path/to/packages/cli/bin/metabot" >&2
    exit 1
  fi
  # Feed METABOT_CORE_URL / METABOT_CORE_TOKEN from the bridge .env WITHOUT
  # clobbering values already set in the environment.
  local envf="$METABOT_HOME/.env"
  if [[ -f "$envf" ]]; then
    local k
    for k in METABOT_CORE_URL METABOT_CORE_TOKEN; do
      if [[ -z "${!k:-}" ]]; then
        local line
        line="$(grep -E "^${k}=" "$envf" | tail -n1 || true)"
        if [[ -n "$line" ]]; then
          export "${k}=$(printf '%s' "${line#${k}=}" | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'\$//")"
        fi
      fi
    done
  fi
  exec node "$core_cli" "$@"
}

# --- Category 2: bridge daemon API (curls the local bridge at localhost:9100) ---
cmd_bridge_api() {
  _load_bridge_api_config
  local cmd="$1"; shift 2>/dev/null || true
  case "$cmd" in
    bots|b)
      curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/bots" | _json
      ;;
    bot)
      curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/bots/$1" | _json
      ;;
    talk|t)
      local bot="$1" chat="$2"; shift 2 2>/dev/null || true
      local prompt="$*"
      if [[ -z "${bot:-}" || -z "${chat:-}" || -z "${prompt:-}" ]]; then
        echo "Usage: metabot talk [peer/]<botName> <chatId> <prompt>"
        echo "  Examples:"
        echo "    metabot talk mybot chat123 'fix the bug'"
        echo "    metabot talk alice/backend-bot chat123 'deploy to staging'"
        exit 1
      fi
      python3 -c "
import json, sys
print(json.dumps({'botName': sys.argv[1], 'chatId': sys.argv[2], 'prompt': sys.argv[3], 'sendCards': True}))
" "$bot" "$chat" "$prompt" | \
      curl -s -X POST "$METABOT_URL/api/talk" \
        -H "$METABOT_AUTH" -H "Content-Type: application/json" \
        -d @-
      ;;
    schedule|sched|sc)
      local subcmd="${1:-list}"; shift 2>/dev/null || true
      case "$subcmd" in
        list|ls)
          curl -s -H "$METABOT_AUTH" "$METABOT_URL/api/schedule" | _json
          ;;
        add|a)
          local bot="$1" chat="$2" delay="$3"; shift 3 2>/dev/null || true
          local prompt="$*"
          if [[ -z "${bot:-}" || -z "${chat:-}" || -z "${delay:-}" || -z "${prompt:-}" ]]; then
            echo "Usage: metabot schedule add <botName> <chatId> <delaySeconds> <prompt>"
            exit 1
          fi
          python3 -c "
import json, sys
print(json.dumps({'botName': sys.argv[1], 'chatId': sys.argv[2], 'delaySeconds': int(sys.argv[3]), 'prompt': sys.argv[4]}))
" "$bot" "$chat" "$delay" "$prompt" | \
          curl -s -X POST "$METABOT_URL/api/schedule" \
            -H "$METABOT_AUTH" -H "Content-Type: application/json" \
            -d @- | _json
          ;;
        cron|c)
          local bot="$1" chat="$2" cron_expr="$3"; shift 3 2>/dev/null || true
          local prompt="$*"
          if [[ -z "${bot:-}" || -z "${chat:-}" || -z "${cron_expr:-}" || -z "${prompt:-}" ]]; then
            echo "Usage: metabot schedule cron <botName> <chatId> '<cronExpr>' <prompt>"
            echo "  Example: metabot schedule cron mybot oc_xxx '0 8 * * 1-5' Generate daily report"
            exit 1
          fi
          python3 -c "
import json, sys
print(json.dumps({'botName': sys.argv[1], 'chatId': sys.argv[2], 'cronExpr': sys.argv[3], 'prompt': sys.argv[4]}))
